@echo off
title SC Bridge — Installation
cd /d "%USERPROFILE%\Desktop"
if not exist sc-bridge mkdir sc-bridge
cd sc-bridge

echo {"type":"module"} > package.json

echo Decodage sc_bridge.js...
powershell -NoProfile -Command "$b='';[System.IO.File]::WriteAllText('%CD%\sc_bridge.js',[System.Text.Encoding]::UTF8.GetString([System.Convert]::FromBase64String($b)))"

echo Installation ws...
call npm install ws --save-quiet 2>nul

echo.
echo Lancement sc_bridge.js sur port 8766...
echo Laissez cette fenetre ouverte pendant que vous tradez.
echo.
node sc_bridge.js
pause
