@echo off
title SC Bridge - Installation
cd /d "%USERPROFILE%\Desktop"
if not exist sc-bridge mkdir sc-bridge
cd sc-bridge
echo {"type":"module"} > package.json

echo Decodage sc_bridge.js...
set btmp=%TEMP%\sc_b64.tmp
(
echo 
echo 
echo 
echo 
echo 
echo 
) > %btmp%
powershell -NoProfile -Command "$f='%CD%\sc_bridge.js';[IO.File]::WriteAllText($f,[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String([IO.File]::ReadAllText('%btmp%').Trim())))"
del %btmp%

echo Installation ws...
call npm install ws --save-quiet 2^>nul
node sc_bridge.js
pause