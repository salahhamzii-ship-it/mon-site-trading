// ═══════════════════════════════════════════════════════════════
// CAMEL COCKPIT v2 — NQ / ES
// Dalton-Salah Method | AVWAP 18H · SD Bands · Prev Session VA
// ═══════════════════════════════════════════════════════════════
//@version=5
indicator("Camel Cockpit v2 — NQ/ES", overlay=true,
     max_lines_count=100, max_labels_count=50, max_boxes_count=10)

// ───────────────────────────────────────────
// INPUTS
// ───────────────────────────────────────────
i_avwap   = input.bool(true,  "AVWAP 18H + SD Bands",      group="AVWAP / SD")
i_va      = input.bool(true,  "Previous Session VAH/VAL/POC", group="Value Area")
i_labels  = input.bool(true,  "Labels",                     group="Display")
i_table   = input.bool(true,  "Dashboard table",            group="Display")
i_bg      = input.bool(true,  "Session background",         group="Display")

// ───────────────────────────────────────────
// SESSION DETECTION  (New York / Eastern)
// ───────────────────────────────────────────
TZ = "America/New_York"

// RTH  09:30 – 16:00
in_rth       = not na(time("1", "0930-1600", TZ))
rth_first    = in_rth and not in_rth[1]
rth_last     = not in_rth and in_rth[1]

// Globex anchor bar  18:00
in_anchor    = not na(time("1", "1800-1801", TZ))
anchor_new   = in_anchor and not in_anchor[1]

// ───────────────────────────────────────────
// TYPICAL PRICE
// ───────────────────────────────────────────
tp = (high + low + close) / 3.0

// ═══════════════════════════════════════════
// 1.  AVWAP 18H + SD±1/±2
//     Anchors at 18:00 ET (Globex open)
//     SD formula: √[ Σ(tp²·v)/Σv  −  avwap² ]
// ═══════════════════════════════════════════
var float a_vol  = 0.0
var float a_pv   = 0.0
var float a_pv2  = 0.0

if anchor_new
    a_vol := 0.0
    a_pv  := 0.0
    a_pv2 := 0.0

a_vol += volume
a_pv  += tp * volume
a_pv2 += tp * tp * volume

avwap = a_vol > 0 ? a_pv / a_vol : na

float sd = na
if not na(avwap) and a_vol > 0
    float v2 = a_pv2 / a_vol - avwap * avwap
    sd := v2 > 0.0 ? math.sqrt(v2) : na

sd2u = not na(sd) ? avwap + 2.0 * sd : na   // SD+2  ★★★ Questionable High
sd1u = not na(sd) ? avwap + 1.0 * sd : na   // SD+1
sd1d = not na(sd) ? avwap - 1.0 * sd : na   // SD-1
sd2d = not na(sd) ? avwap - 2.0 * sd : na   // SD-2  ★★★ LBF Zone

// ═══════════════════════════════════════════
// 2.  PREVIOUS SESSION  VAH / VAL / POC
//     Calculated on the closed RTH session.
//     POC  = session VWAP  (volume-weighted POC proxy)
//     VAH  = VWAP + 1 SD  (≈ 70 % value area top)
//     VAL  = VWAP − 1 SD  (≈ 70 % value area bottom)
//     These values freeze at RTH close and carry
//     through the next session.
// ═══════════════════════════════════════════
var float s_vol  = 0.0
var float s_pv   = 0.0
var float s_pv2  = 0.0

// Accumulate only during RTH
if in_rth
    s_vol += volume
    s_pv  += tp * volume
    s_pv2 += tp * tp * volume

// Freeze at RTH close → these become "previous session" values
var float prev_poc = na
var float prev_vah = na
var float prev_val = na

if rth_last and s_vol > 0
    float poc_now = s_pv / s_vol
    float var_now = s_pv2 / s_vol - poc_now * poc_now
    float sd_now  = var_now > 0.0 ? math.sqrt(var_now) : na
    prev_poc := poc_now
    prev_vah := not na(sd_now) ? poc_now + sd_now : na
    prev_val := not na(sd_now) ? poc_now - sd_now : na
    // Reset accumulators for next session
    s_vol := 0.0
    s_pv  := 0.0
    s_pv2 := 0.0

// ───────────────────────────────────────────
// COLORS
// ───────────────────────────────────────────
C_RED   = color.new(#FF3B3B, 0)
C_ORG   = color.new(#FF9500, 30)
C_YEL   = color.new(#FFD700, 0)
C_TEA   = color.new(#00CCAA, 30)
C_GRN   = color.new(#00E676, 0)
C_VAH   = color.new(#CE93D8, 0)   // purple-light  VAH
C_VAL   = color.new(#80CBC4, 0)   // teal-light    VAL
C_POC   = color.new(#FFAB40, 0)   // amber         POC

// ═══════════════════════════════════════════
// PLOTS — AVWAP + SD BANDS
// ═══════════════════════════════════════════
p_sd2u = plot(i_avwap ? sd2u  : na, "SD+2 ★ Q.High", C_RED,  1)
p_sd1u = plot(i_avwap ? sd1u  : na, "SD+1",           C_ORG,  1)
p_av   = plot(i_avwap ? avwap : na, "AVWAP 18H ★★★", C_YEL,  2)
p_sd1d = plot(i_avwap ? sd1d  : na, "SD-1",           C_TEA,  1)
p_sd2d = plot(i_avwap ? sd2d  : na, "SD-2 ★ LBF",    C_GRN,  1)

// Soft fill between SD+1↔SD+2 (danger) and SD-1↔SD-2 (opportunity)
fill(p_sd2u, p_sd1u, color.new(color.red,   93), "SD+2 zone")
fill(p_sd1d, p_sd2d, color.new(color.green, 93), "SD-2 zone")

// ═══════════════════════════════════════════
// PLOTS — PREV SESSION VAH / POC / VAL
// ═══════════════════════════════════════════
p_vah = plot(i_va ? prev_vah : na, "Prev VAH ★★★", C_VAH, 2, plot.style_stepline)
p_poc = plot(i_va ? prev_poc : na, "Prev POC ★★★", C_POC, 2, plot.style_stepline)
p_val = plot(i_va ? prev_val : na, "Prev VAL ★★★", C_VAL, 2, plot.style_stepline)

// Subtle value area fill
fill(p_vah, p_val, color.new(color.orange, 96), "Value Area")

// ═══════════════════════════════════════════
// LABELS — at RTH open (once per session)
// ═══════════════════════════════════════════
_lbl(idx, price, txt, tc, bc) =>
    label.new(idx, price, txt,
         xloc=xloc.bar_index, yloc=yloc.price,
         color=color.new(bc, 78), textcolor=tc,
         style=label.style_label_left, size=size.small)

if i_labels and rth_first
    fmt = format.mintick
    if not na(sd2u)
        _lbl(bar_index, sd2u,     "SD+2  " + str.tostring(sd2u,     fmt), C_RED, color.red)
    if not na(sd1u)
        _lbl(bar_index, sd1u,     "SD+1  " + str.tostring(sd1u,     fmt), C_ORG, color.orange)
    if not na(avwap)
        _lbl(bar_index, avwap,    "AVWAP " + str.tostring(avwap,    fmt), C_YEL, color.yellow)
    if not na(sd1d)
        _lbl(bar_index, sd1d,     "SD-1  " + str.tostring(sd1d,     fmt), C_TEA, color.teal)
    if not na(sd2d)
        _lbl(bar_index, sd2d,     "SD-2  " + str.tostring(sd2d,     fmt), C_GRN, color.green)
    if not na(prev_vah)
        _lbl(bar_index, prev_vah, "VAH   " + str.tostring(prev_vah, fmt), C_VAH, color.purple)
    if not na(prev_poc)
        _lbl(bar_index, prev_poc, "POC   " + str.tostring(prev_poc, fmt), C_POC, color.orange)
    if not na(prev_val)
        _lbl(bar_index, prev_val, "VAL   " + str.tostring(prev_val, fmt), C_VAL, color.teal)

// ═══════════════════════════════════════════
// DASHBOARD TABLE — top right
// ═══════════════════════════════════════════
if i_table and barstate.islast
    var table T = table.new(position.top_right, 2, 12,
         bgcolor      = color.new(color.black, 72),
         border_color = color.new(color.gray,  55),
         border_width = 1,
         frame_color  = color.new(color.gray,  40),
         frame_width  = 1)

    _th(txt) =>
        table.cell(T, 0, 0, txt, text_color=color.white, text_size=size.small,
             bgcolor=color.new(color.black, 50), text_halign=text.align_center)
        table.cell(T, 1, 0, syminfo.ticker, text_color=color.new(color.gray, 0),
             text_size=size.small, bgcolor=color.new(color.black, 50), text_halign=text.align_right)

    _row(r, lbl, val, tc) =>
        table.cell(T, 0, r, lbl, text_color=color.new(tc, 0), text_size=size.tiny,
             text_halign=text.align_left,  bgcolor=color.new(color.black, 82))
        table.cell(T, 1, r, not na(val) ? str.tostring(val, format.mintick) : "–",
             text_color=color.new(tc, 0), text_size=size.tiny,
             text_halign=text.align_right, bgcolor=color.new(color.black, 82))

    _sep(r, txt) =>
        table.cell(T, 0, r, txt, text_color=color.new(color.gray, 40),
             text_size=size.tiny, text_halign=text.align_left, bgcolor=color.new(color.black, 88))
        table.cell(T, 1, r, "", bgcolor=color.new(color.black, 88))

    _th("🐪  CAMEL COCKPIT")
    _sep(1,  "── AVWAP 18H ──────────")
    _row(2,  "SD+2  ★★★ Q.High", sd2u,     color.red)
    _row(3,  "SD+1",              sd1u,     color.orange)
    _row(4,  "AVWAP 18H  👑",    avwap,    color.yellow)
    _row(5,  "SD-1",              sd1d,     color.teal)
    _row(6,  "SD-2  ★★★ LBF",   sd2d,     color.green)
    _sep(7,  "── Prev Session ───────")
    _row(8,  "VAH  ★★★",         prev_vah, color.purple)
    _row(9,  "POC  ★★★",         prev_poc, color.orange)
    _row(10, "VAL  ★★★",         prev_val, color.teal)

// ═══════════════════════════════════════════
// SESSION BACKGROUND
// ═══════════════════════════════════════════
bgcolor(i_bg and in_rth ? color.new(color.gray, 97) : na, title="RTH Session")

// ═══════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════
alertcondition(
     not na(sd2u) and high >= sd2u and high[1] < sd2u[1],
     "SD+2 Touch — Questionable High (R34)",
     "🔴 SD+2 touched. Questionable High. Watch for LAF / rejection.")

alertcondition(
     not na(sd2d) and low <= sd2d and low[1] > sd2d[1],
     "SD-2 Touch — LBF Zone (R35)",
     "🟢 SD-2 touched. LBF Zone. Watch for Look Below and Fail.")

alertcondition(
     not na(avwap) and close > avwap and close[1] <= avwap[1],
     "AVWAP 18H Cross — Bullish",
     "⬆️ Close crossed above AVWAP 18H.")

alertcondition(
     not na(avwap) and close < avwap and close[1] >= avwap[1],
     "AVWAP 18H Cross — Bearish",
     "⬇️ Close crossed below AVWAP 18H.")

alertcondition(
     not na(prev_vah) and close > prev_vah and close[1] <= prev_vah[1],
     "Price accepted above VAH ★★★",
     "🟣 Close accepted above previous VAH. Bullish follow-through possible.")

alertcondition(
     not na(prev_val) and close < prev_val and close[1] >= prev_val[1],
     "Price accepted below VAL ★★★",
     "🔵 Close accepted below previous VAL. Bearish follow-through possible.")
